{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "tinytalk.api:app"
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build:live",
      "devCommand": "npm run dev:live",
      "outputDirectory": "dist",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "app" } },
    { "source": "/api/(.*)", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
